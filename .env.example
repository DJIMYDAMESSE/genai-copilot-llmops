# Moteur de génération : local (extractif, sans GPU) | openai (vLLM, Ollama, Azure OpenAI...)
LLM_PROVIDER=openai
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=not-needed
LLM_TIMEOUT_S=60
LLM_FALLBACK_LOCAL=true
COPILOT_TOP_K=4
COPILOT_MIN_RELEVANCE=0.12
# Laisser vide en local ; obligatoire en production
COPILOT_API_KEY=
